<IfModule LiteSpeed>
    RewriteEngine On
    RewriteRule .* - [E=verifycaptcha:off]
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect www to non-www
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
